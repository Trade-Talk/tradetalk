# Market Data API Keys
# Choose one provider (Finnhub recommended)

# Finnhub - https://finnhub.io/register
# Free tier: 60 calls/minute
VITE_FINNHUB_KEY=your_finnhub_key_here

# Alpha Vantage - https://www.alphavantage.co/support/#api-key  
# Free tier: 5 calls/minute
VITE_ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# Feature Flags
VITE_ENABLE_MARKET_DATA=true
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_REALTIME_UPDATES=false

# Supabase (your existing config)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_key
